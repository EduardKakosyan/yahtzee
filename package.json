{
  "name": "camp-yahtzee",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "icons": "node scripts/gen-icons.mjs",
    "build": "node build.mjs",
    "serve": "node serve.mjs public 3000",
    "test:unit": "node --test tests/*.test.js",
    "test": "node build.mjs && npx playwright test",
    "test:controls": "node build.mjs && playwright test --config playwright.controls.config.ts",
    "verify": "bash scripts/verify.sh"
  },
  "devDependencies": {
    "@playwright/test": "1.63.0"
  }
}
